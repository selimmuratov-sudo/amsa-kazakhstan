# Copy to .env and fill with values for the target environment.
# Local development uses SQLite by default; production should use PostgreSQL over TLS.
AMSA_ENVIRONMENT=development
AMSA_DATABASE_URL=sqlite:///./data/platform.sqlite3
AMSA_COOKIE_SECURE=false
AMSA_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Optional stable random HMAC pepper for pseudonymous login-rate-limit keys.
AMSA_AUTH_RATE_LIMIT_PEPPER=
# Required for backup commands. Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Store this key separately from encrypted backup files.
AMSA_BACKUP_ENCRYPTION_KEY=
AMSA_BACKUP_DIRECTORY=data/backups
# Encrypt uploaded exchange documents at rest; keep this key separate from the backup key.
AMSA_PRIVATE_FILES_ENCRYPTION_KEY=
# Optional: approved Google Forms view URL, e.g. https://docs.google.com/forms/d/e/FORM_ID/viewform
# Embedded only when it is HTTPS on docs.google.com under /forms/d/e/.../viewform.
AMSA_GOOGLE_REPORTS_FORM_URL=
# Optional server-side Sheets sync. Share the target spreadsheet with the service-account email as Editor.
# Store the service-account JSON outside source control and point to its absolute path.
AMSA_GOOGLE_REPORTS_SPREADSHEET_ID=
AMSA_GOOGLE_SERVICE_ACCOUNT_FILE=
AMSA_GOOGLE_REPORTS_SHEET_NAME=Committee Reports
